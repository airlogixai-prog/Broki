# Los secrets de importación viven en Supabase Functions, no en el frontend.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local: JWT anon (eyJ...). Remoto: publishable (sb_publishable_...) — el código acepta cualquiera de los dos nombres.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
