      "notes": "POST must call assertUserCanWrite"
    },
    "equipment-update": {
      "get": null,
      "post": "dashboard:write",
      "service": ["next-server", "remote-smoke"],
      "public": false
    },
    "broki-import-batch": {
      "get": null,
      "post": null,
      "service": ["n8n", "remote-smoke"],
      "public": false,
      "notes": "service-only ETL"
    },
    "personnel-register": {
      "get": null,
      "post": null,
      "service": [],
      "public": true,
      "notes": "Creates pending personnel only — never broki_user_access"
    },
    "marketing-lead": {
      "get": null,
      "post": null,
      "service": [],
